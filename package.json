{
  "name": "nossasaude-server",
  "version": "1.0.0",
  "description": "Family medical history backend — serverless Node.js + AWS Lambda + MongoDB + S3",
  "main": "handler.js",
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "nodemon --exec \"serverless offline -c serverless-dev.yml\"",
    "deploy": "serverless deploy --verbose",
    "test": "jest --silent --coverage",
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/s3-request-presigner": "^3.787.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "mongoose": "^8.13.2"
  },
  "devDependencies": {
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "osls": "^3.63.2",
    "prettier": "^3.5.3",
    "serverless-offline": "^14.4.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
